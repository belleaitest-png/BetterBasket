# Copy to .env and fill in your values
ANTHROPIC_API_KEY=your_api_key_here

# CORS: comma-separated origins allowed to call the API
# CORS_ORIGINS=https://your-frontend.vercel.app,http://localhost:3000

# Model overrides (defaults to claude-sonnet-4-5 for all)
# ONBOARDING_MODEL=claude-sonnet-4-5
# EVALUATOR_MODEL=claude-sonnet-4-5
# SUMMARY_MODEL=claude-sonnet-4-5
# LIST_MODEL=claude-sonnet-4-5

# Log level (DEBUG, INFO, WARNING, ERROR)
# LOG_LEVEL=INFO

# Frontend: backend API URL (used by Next.js rewrites)
# NEXT_PUBLIC_API_URL=https://your-backend.example.com

# Optional: database URL (defaults to SQLite)
DATABASE_URL=sqlite+aiosqlite:///./betterbasket.db

# Optional: Redis URL for session state (Phase 2)
# REDIS_URL=redis://localhost:6379
